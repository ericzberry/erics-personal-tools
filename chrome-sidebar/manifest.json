{
  "manifest_version": 3,
  "name": "Eric's Personal Tools",
  "version": "0.6.99",
  "description": "Personal restaurant reservation searches, travel wallet, AI settings, ESPN draft advice, and Gmail assistance.",
  "minimum_chrome_version": "116",
  "permissions": [
    "sidePanel",
    "contextMenus",
    "storage",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Eric's Personal Tools",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fantasy.espn.com/football/draft*"
      ],
      "js": [
        "src/draft-reader.js",
        "src/components/espn-highlights.js",
        "src/espn-highlights-content.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "src/gmail-reader.js",
        "src/gmail-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  },
  "omnibox": {
    "keyword": "ericberry"
  }
}
